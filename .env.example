# ==============================================================================
# CelebrationOS - Environment Variables Example
# ==============================================================================
# CelebrationOS uses a client-side zero-secret architecture.
# Keys entered in the UI are held exclusively in volatile browser memory / localStorage.
# For local development or build overrides, configure the variable below:

# Optional: Google Gemini AI Studio API Key (Defaults to client UI input if blank)
VITE_GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHereForLocalDev33Chars

# Application Environment Mode
NODE_ENV=production
